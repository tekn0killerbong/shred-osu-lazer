<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <NuGetAudit>false</NuGetAudit>
    <ShredRulesetProject Condition="'$(ShredRulesetProject)' == ''">../osu.Game.Rulesets.Shred/osu.Game.Rulesets.Shred.csproj</ShredRulesetProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(ShredRulesetProject)" />
    <Reference Include="osu.Game" Condition="'$(ShredGameAssembly)' != ''">
      <HintPath>$(ShredGameAssembly)</HintPath>
    </Reference>
  </ItemGroup>
</Project>
